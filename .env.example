# Elko Projects — environment variables
# Copy to .env.local for local development (do not commit .env.local).

# Canonical site origin, used for sitemap, robots, canonical URLs and OG tags.
# Staging:    https://elkoprojects.ewebmarketing.dev
# Production:  https://www.elkoprojects.com.au
NEXT_PUBLIC_SITE_URL=https://www.elkoprojects.com.au

# Show the unconfirmed headline stats (22+ years, 100+ projects, 50+ reviews) and
# the "$5M+ annual turnover" slot on the homepage stats band, the reviews heading
# and the hero director badge.
#   staging:    true  (so the client can review the numbers in context)
#   production: leave unset / false until the client signs the numbers off
# See docs/CLIENT_TODO.md.
NEXT_PUBLIC_SHOW_UNCONFIRMED_STATS=false
