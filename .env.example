# Elko Projects — environment variables
# Copy to .env.local for local development (do not commit .env.local).

# Canonical site origin, used for sitemap, robots, canonical URLs and OG tags.
# Staging:    https://elkoprojects.ewebmarketing.dev
# Production:  https://www.elkoprojects.com.au
NEXT_PUBLIC_SITE_URL=https://www.elkoprojects.com.au

# Show the unconfirmed headline stats (22+ years, 100+ projects, 50+ reviews) and
# the "$5M+ annual turnover" slot on the homepage stats band, the reviews heading
# and the hero director badge.
#   staging:    true  (so the client can review the numbers in context)
#   production: leave unset / false until the client signs the numbers off
# See docs/CLIENT_TODO.md.
NEXT_PUBLIC_SHOW_UNCONFIRMED_STATS=false

# --- Enquiry forms (server-side email via Resend) --------------------------
# Both the Contact form (/contact-us) and the Book-a-consultation form
# (/book-a-consultation) email each enquiry to the office and send the enquirer
# a confirmation. Without RESEND_API_KEY the forms still work (return success)
# but no email is sent — fine for staging, set it for production. Verify the
# sending domain in Resend first.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiry notifications are delivered. Comma-separated for several
# recipients. When unset, the code default is:
#   admin@elkoprojects.com.au, jisan@ewebmarketing.com.au,
#   nauman@ewebmarketing.com.au, sam@ewebmarketing.com.au
# (see lib/email.ts). Set this to override.
CONTACT_EMAIL=admin@elkoprojects.com.au,jisan@ewebmarketing.com.au,nauman@ewebmarketing.com.au,sam@ewebmarketing.com.au

# The From address on outgoing mail. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Elko Projects Website <noreply@elkoprojects.com.au>"
